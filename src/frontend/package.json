{
  "name": "slm-educator-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "lint": "cd ../.. && src/frontend/node_modules/.bin/eslint --config src/frontend/eslint.config.js src/frontend/src tests/frontend",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
